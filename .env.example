# ── Variables de entorno requeridas ───────────────────────────────────────────
# Copia este archivo como .env para pruebas locales (nunca subas .env al repo).
# En GitHub Actions configura estos valores como Repository Secrets.

# Dirección de correo del remitente
SENDER_EMAIL=jmoya@colegiocabodehornos.cl

# Nombre que aparecerá como remitente
SENDER_NAME=Colegio Cabo de Hornos

# Servidor SMTP de Outlook / Microsoft 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# Usuario SMTP (el mismo correo de Outlook)
SMTP_USER=jmoya@colegiocabodehornos.cl

# Contraseña de la cuenta Outlook o contraseña de aplicación si tiene MFA activo
SMTP_PASS=tu_contrasena_de_outlook
